# PostgreSQL settings used by the local Compose service and FastAPI.
# Name of the local application database.
POSTGRES_DB=devopsmart
# Database role used by the application.
POSTGRES_USER=devopsmart
# Replace this placeholder with a private local development password.
POSTGRES_PASSWORD=replace-with-a-private-local-password
# Host port exposed on 127.0.0.1.
POSTGRES_PORT=5432
# Hostname used by FastAPI when connecting from the Windows host.
POSTGRES_HOST=127.0.0.1

# Optional FastAPI settings (defaults shown).
# Display name used by the FastAPI application.
DEVOPSMART_APP_NAME=DevOpsMart API
# Label for the running application environment.
DEVOPSMART_ENVIRONMENT=development
# Enable FastAPI debug mode only for local development.
DEVOPSMART_DEBUG=false

# Optional full SQLAlchemy URL override; otherwise POSTGRES_* builds the URL.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# DEVOPSMART_DATABASE_URL=postgresql+psycopg://devopsmart:replace-with-a-private-local-password@127.0.0.1:5432/devopsmart
